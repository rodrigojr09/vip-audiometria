{
    "compilerOptions": {
        "target": "ESNext",
        "module": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "moduleResolution": "node16",
        "resolveJsonModule": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*",
    ],
    "exclude": [
        "node_modules",
        "prisma"
    ]
}